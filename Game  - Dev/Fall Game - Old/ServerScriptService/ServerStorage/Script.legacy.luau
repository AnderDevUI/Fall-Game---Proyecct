local IDS = string.split("3740895541 159115655 8834060 1866308749 5607314582 5658333801", " ")
local Users = game:GetService("UserService")

local module = require(game.ServerStorage.Modules.ModUtil)

local function sendMsg(message)
	game:GetService("MessagingService"):PublishAsync("FallenGuard", {Type = "SystemMessage", Message = message})
end
print("STARTING")
for _, id in pairs(IDS) do
	id = tonumber(id)
	while true do
		local suc, infos = pcall(function()
			return Users:GetUserInfosByUserIdsAsync({id})
		end)
		if not suc or not infos[1] then
			print("userservice fail", infos)
			continue
		end
		local info = infos[1]
		local username = info.Username
		local dispname = info.DisplayName
		task.defer(function()
			local banArgs = {module:BanPlayer(username, nil, game:GetService("Players").ChickenBagelz, "RO-EXEC [UNAPPEALABLE]")}
			if not banArgs[1] then
				warn("BAN FAILED FOR", username, id, "-", unpack(banArgs))
			end
		end)
		sendMsg((dispname == username and "@"..username or `{dispname}(@{username})`).." WAS BANNED BY FALLENGUARD")
		break
	end
	task.wait(2)
end
print("DONE")


