-- [PATH] ServerStorage / Script @Type Script
local util = require(game.ReplicatedStorage.Modules.RaycastUtil)
local test = workspace.TestSpawns
local start = test.Start.Position
local en = test.End.Position

print("starting")

for _, v in pairs(workspace.SpawnAreas.All:GetChildren()) do
	v.Parent = workspace.SpawnAreas[(v.BrickColor == BrickColor.new("Bright blue") and "Tundra" or (v.BrickColor == BrickColor.new("Bright green") and "Forest" or "Desert")).."Spawns"]
end

for i, part in pairs(all:GetChildren()) do
	if not (part and part.Parent) then continue end
	local x = 0
	local added = {}
	while x < 2048 - 64 do
		x += 64
		local hit = util:Raycast(part.Position + Vector3.new(x, 50, 0), Vector3.new(0, -100, 0), "Whitelist", all)
		if hit == nil or (hit and hit.BrickColor ~= part.BrickColor) or hit.Size ~= part.Size then
			break
		end
		table.insert(added, hit)
	end
	local z = 0
	while z < 2048 - 64 do
		z += 64
		local broke = false
		local curAdded = {}
		for curX = part.Position.X, part.Position.X + (x - 64), 64 do
			local hit1 = util:Raycast(Vector3.new(curX, part.Position.Y, part.Position.Z) + Vector3.new(0, 50, z), Vector3.new(0, -100, 0), "Whitelist", all)
			if hit1 == nil or (hit1 and hit1.BrickColor ~= part.BrickColor) or hit1.Size ~= part.Size then
				broke = true
				break
			end
			table.insert(curAdded, hit1)
		end
		if broke then break end
		for _, v in pairs(curAdded) do
			table.insert(added, v)
		end
	end
	for _, add in pairs(added) do
		add:Destroy()
	end
	z += 64
	local size = Vector3.new(x, part.Size.Y, z)
	local offset = Vector3.new(x - 64, 0, z - 64) / 2
	part.Position = part.Position + offset
	part.Size = size
	if i % 50 == 0 then
		task.wait()
	end
end
print("done")

for z = start.Z, en.Z, 64 do
	for x = start.X, en.X, 64 do
		local position = Vector3.new(x, start.Y, z)
		local hit, pos, nor, mat = util:Raycast(position, Vector3.new(0, -1000, 0), "Whitelist", workspace.Terrain)
		if mat == Enum.Material.Water then continue end
		local matName = (mat and mat.Name)
		local p = test.Start:Clone()
		p.BrickColor = BrickColor.new((matName == "Snow" or matName == "Ice" or matName == "Glacier") and "Bright blue" or ((matName == "Sand" or matName == "Sandstone") and "Bright yellow" or "Bright green"))
		p.Position = position
		p.Parent = all
	end
	game:GetService("RunService").Heartbeat:Wait()
end


